meta {
  name: Login (user)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ivan@example.com",
    "password": "secret123"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("токен получен", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}
