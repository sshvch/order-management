meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "ivan@example.com",
    "password": "secret123"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("пользователь создан", function () {
    expect(res.status).to.equal(201);
    expect(res.body.email).to.equal("ivan@example.com");
  });
}
