meta {
  name: Create order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  bru.setVar("orderId", res.body.id);
}

tests {
  test("заказ создан", function () {
    expect(res.status).to.equal(201);
  });
}
